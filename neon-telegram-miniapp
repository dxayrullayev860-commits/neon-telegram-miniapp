logging.basicConfig(level=logging.INFO)
log = logging.getLogger("neon-miniapp")
BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
WEBAPP_URL = os.getenv("WEBAPP_URL", "").strip()
PORT = int(os.getenv("PORT", "8000"))

if not BOT_TOKEN:
    raise RuntimeError("BOT_TOKEN environment variable is required.")

mp_hands = mp.solutions.hands
app = FastAPI(title="Neon Hand Mini App")
app.mount("/static", StaticFiles(directory="static"), name="static")


def verify_telegram_init_data(init_data: str) -> bool:
    if not init_data:
        return False
    try:
        parsed = dict(parse_qsl(init_data, keep_blank_values=True))
        received_hash = parsed.pop("hash", None)
        if not received_hash:
            return False
        check = "\n".join(f"{k}={v}" for k, v in sorted(parsed.items()))
        secret = hmac.new(
            b"WebAppData", BOT_TOKEN.encode(), hashlib.sha256
        ).digest()
        calculated = hmac.new(
            secret, check.encode(), hashlib.sha256
        ).hexdigest()
        return hmac.compare_digest(calculated, received_hash)
    except Exception:
        return False


def neon_line(img, p1, p2, color=(255, 40, 210), thickness=2):
    overlay = img.copy()
    cv2.line(overlay, p1, p2, color, thickness + 8, cv2.LINE_AA)
    overlay = cv2.GaussianBlur(overlay, (0, 0), 8)
    img[:] = cv2.addWeighted(img, 1.0, overlay, 0.35, 0)
    cv2.line(img, p1, p2, color, thickness, cv2.LINE_AA)


def neon_circle(img, center, radius, color=(255, 40, 210)):
    overlay = img.copy()
    cv2.circle(overlay, center, radius, color, 5, cv2.LINE_AA)
    overlay = cv2.GaussianBlur(overlay, (0, 0), 7)
    img[:] = cv2.addWeighted(img, 1.0, overlay, 0.4, 0)
    cv2.circle(img, center, radius, (255, 120, 235), 2, cv2.LINE_AA)


def draw_finger_web(frame, points, t):
    for a, b in mp_hands.HAND_CONNECTIONS:
        neon_line(frame, points[a], points[b])

    xs = [p[0] for p in points]
    ys = [p[1] for p in points]
    cx, cy = int(sum(xs) / len(xs)), int(sum(ys) / len(ys))

    span = max(
        80,
        int(math.hypot(
            points[5][0] - points[17][0],
            points[5][1] - points[17][1]
        ) * 2)
    )
    r = int(span * (1.15 + 0.08 * math.sin(t * 2)))
    vertices = []

    for i in range(6):
        angle = t * 0.35 + i * math.pi / 3 - math.pi / 2
        vertices.append((
            int(cx + r * math.cos(angle)),
            int(cy + r * math.sin(angle) * 0.82)
        ))

    for i in range(6):
        neon_line(
            frame, vertices[i], vertices[(i + 1) % 6],
            (255, 35, 205), 2
        )
        neon_line(
            frame, vertices[i],
            points[[0, 4, 8, 12, 16, 20][i]],
            (210, 40, 255), 1
        )

    tips = [points[i] for i in (4, 8, 12, 16, 20)]

    for i in range(len(tips)):
        for j in range(i + 1, len(tips)):
            if (i + j + int(t * 3)) % 2 == 0:
                neon_line(frame, tips[i], tips[j], (200, 65, 255), 1)

    for tip in tips:
        neon_circle(frame, tip, 5)


def process_image_bytes(data):
    arr = np.frombuffer(data, dtype=np.uint8)
    frame = cv2.imdecode(arr, cv2.IMREAD_COLOR)

    if frame is None:
        raise ValueError("Rasmni ochib bo‘lmadi. JPG yoki PNG yuboring.")

    if frame.shape[0] * frame.shape[1] > 20_000_000:
        raise ValueError("Rasm 20 megapikseldan kichik bo‘lsin.")

    with mp_hands.Hands(
        static_image_mode=True,
        max_num_hands=2,
        model_complexity=1,
        min_detection_confidence=0.5
    ) as hands:
        result = hands.process(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))

    if result.multi_hand_landmarks:
        h, w = frame.shape[:2]
        for hand in result.multi_hand_landmarks:
            pts = [
                (int(lm.x * w), int(lm.y * h))
                for lm in hand.landmark
            ]
            draw_finger_web(frame, pts, time.time() % 100)
    else:
        cv2.putText(
            frame, "No hand detected", (20, 40),
            cv2.FONT_HERSHEY_SIMPLEX, 0.8,
            (255, 120, 235), 2, cv2.LINE_AA
        )

    ok, encoded = cv2.imencode(
        ".jpg", frame, [cv2.IMWRITE_JPEG_QUALITY, 92]
    )

    if not ok:
        raise ValueError("Natijani yaratib bo‘lmadi.")

    return encoded.tobytes()


@app.get("/")
async def index():
    return FileResponse("static/index.html")


@app.get("/health")
async def health():
    return {"ok": True}


@app.post("/api/process")
async def process_endpoint(
    file: UploadFile = File(...),
    x_telegram_init_data: str = Header(
        default="", alias="X-Telegram-Init-Data"
    )
):
    if x_telegram_init_data and not verify_telegram_init_data(
        x_telegram_init_data
    ):
        raise HTTPException(401, "Telegram tekshiruvi muvaffaqiyatsiz.")

    if file.content_type not in (
        "image/jpeg", "image/png", "image/webp"
    ):
        raise HTTPException(415, "JPG, PNG yoki WEBP rasm yuboring.")

    data = await file.read()

    if not data or len(data) > 12 * 1024 * 1024:
        raise HTTPException(413, "Rasm bo‘sh yoki 12 MB dan katta.")

    try:
        result = await asyncio.to_thread(process_image_bytes, data)
    except ValueError as e:
        raise HTTPException(400, str(e))
    except Exception:
        log.exception("Image processing failed")
        raise HTTPException(500, "Rasmni qayta ishlashda xatolik.")

    return StreamingResponse(
        io.BytesIO(result),
        media_type="image/jpeg",
        headers={
            "Content-Disposition": 'inline; filename="neon-result.jpg"'
        }
    )


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = (
        "Assalomu alaykum! ✨\n"
        "Neon Hand Mini App rasmda qo‘lni aniqlab neon effekt qo‘shadi. "
        "Mini App tugmasini bosing yoki menga rasm yuboring."
    )
    keyboard = None

    if WEBAPP_URL.startswith("https://"):
        keyboard = InlineKeyboardMarkup([[
            InlineKeyboardButton(
                "✨ Mini Appni ochish",
                web_app=WebAppInfo(url=WEBAPP_URL)
            )
        ]])

    await update.effective_message.reply_text(
        text, reply_markup=keyboard
    )


async def help_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.effective_message.reply_text(
        "Mini Appni oching va qo‘l ko‘rinadigan rasm tanlang. "
        "«Neon effekt yaratish» tugmasini bosing. "
        "Botga rasm yuborsangiz ham qayta ishlaydi."
    )


async def handle_photo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    status = await msg.reply_text("Rasmni qayta ishlayapman… ✨")

    try:
        tgfile = await context.bot.get_file(msg.photo[-1].file_id)
        data = bytes(await tgfile.download_as_bytearray())
        result = await asyncio.to_thread(process_image_bytes, data)

        await msg.reply_photo(
            photo=io.BytesIO(result),
            caption="Tayyor! ✨ Neon effekt"
        )
        await status.delete()

    except Exception:
        log.exception("photo processing failed")
        await status.edit_text(
            "Rasmni qayta ishlay olmadim. "
            "Qo‘l aniq ko‘rinadigan rasm yuboring."
        )


async def post_init(application):
    if WEBAPP_URL.startswith("https://"):
        try:
            from telegram import MenuButtonWebApp
            await application.bot.set_chat_menu_button(
                menu_button=MenuButtonWebApp(
                    text="Neon Mini App",
                    web_app=WebAppInfo(url=WEBAPP_URL)
                )
            )
        except Exception:
            log.exception("Menu button setup failed")


def run_web():
    uvicorn.run(app, host="0.0.0.0", port=PORT)


def main():
    threading.Thread(target=run_web, daemon=True).start()

    bot = (
        Application.builder()
        .token(BOT_TOKEN)
        .post_init(post_init)
        .build()
    )

    bot.add_handler(CommandHandler("start", start))
    bot.add_handler(CommandHandler("help", help_cmd))
    bot.add_handler(CommandHandler("app", start))
    bot.add_handler(MessageHandler(filters.PHOTO, handle_photo))

    log.info("Bot va Mini App serveri ishga tushmoqda.")
    bot.run_polling()


if __name__ == "__main__":
    main()
